# Copy to .env and fill in, or run `task langfuse:secrets` which creates it.
# Never commit .env.

# fake: deterministic test engines, no key, no cost. live: Jev, and GPT-6 Luna for
# the parse and the recount, all through OpenRouter: it needs OPENROUTER_API_KEY and
# a daily spending cap, without which the web app does not start.
ENGINES=fake
OPENROUTER_API_KEY=
# DAILY_BUDGET_USD=5

# The two readers of a cart (the defaults): the recount is Luna again, without
# reasoning, chosen for its speed (docs/testing.md, Parser variants).
# PARSE_MODEL=openai/gpt-6-luna
# PARSE_EFFORT=minimal
# RECOUNT_MODEL=openai/gpt-6-luna
# RECOUNT_EFFORT=none
# Most readings of one cart before it is refused as unfaithful.
# READ_ATTEMPTS=3
# Each reader's OpenAI-compatible API (Ollama: http://localhost:11434/v1).
# PARSE_BASE_URL=https://openrouter.ai/api/v1
# RECOUNT_BASE_URL=https://openrouter.ai/api/v1
# Titles whose film is kept in memory; 0 turns the cache off.
# IDENTIFY_CACHE_SIZE=10000

# The ports compose publishes on 127.0.0.1 (the defaults).
# WEB_PORT=24790
# QUOTER_PORT=24793
# DOCS_PORT=24795

# Web session cookie: 32 characters or more (openssl rand -hex 32).
SESSION_SECRET=

# Traces and benches, in the local Langfuse (deploy/langfuse) or any other.
# Optional. LANGFUSE_BASE_URL is for processes on this machine (the quoter, the benches);
# LANGFUSE_DOCKER_BASE_URL for the quoter when it runs in Docker (compose.yml).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_DOCKER_BASE_URL=

# The local Langfuse itself (deploy/langfuse): generated by task langfuse:secrets.
LF_USER_EMAIL=admin@delorean.local
LF_USER_PASSWORD=
LF_DB_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_AUTH=
LF_MINIO_PASSWORD=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_NEXTAUTH_SECRET=
