# Copy to .env and fill in, or run `task langfuse:secrets` which creates it.
# Never commit .env.

# Live engines (Jev, GPT-6 Luna for the parse and DeepSeek for the recount, all
# through OpenRouter). Leave empty and run with ENGINES=fake for the
# deterministic test engines.
OPENROUTER_API_KEY=
ENGINES=live

# The two readers of a cart, of different families (the defaults).
# PARSE_MODEL=openai/gpt-6-luna
# PARSE_EFFORT=minimal
# RECOUNT_MODEL=deepseek/deepseek-v4.1-flash
# RECOUNT_EFFORT=low
# Most readings of one cart before it is refused as unfaithful.
# READ_ATTEMPTS=3
# Each reader's OpenAI-compatible API (Ollama: http://localhost:11434/v1), and
# whether the parse identifies the films too (prompts/parse-films.json).
# PARSE_BASE_URL=https://openrouter.ai/api/v1
# RECOUNT_BASE_URL=https://openrouter.ai/api/v1
# PARSE_IDENTIFIES=false
# Titles whose film is kept in memory; 0 turns the cache off.
# IDENTIFY_CACHE_SIZE=10000

# Web session cookie: 32 characters or more (openssl rand -hex 32).
SESSION_SECRET=

# Traces and benches, in the local Langfuse (deploy/langfuse) or any other.
# LANGFUSE_BASE_URL is for processes on this machine (quoters, benches);
# LANGFUSE_DOCKER_BASE_URL for the quoters when they run in Docker (compose.yml).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_DOCKER_BASE_URL=

# The local Langfuse itself (deploy/langfuse): generated by task langfuse:secrets.
LF_USER_EMAIL=admin@delorean.local
LF_USER_PASSWORD=
LF_DB_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_AUTH=
LF_MINIO_PASSWORD=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_NEXTAUTH_SECRET=
