# Copy to .env and fill in, or run `task langfuse:secrets` which creates it.
# Never commit .env.

# Live engines (Jev and GPT-6 Luna, both through OpenRouter).
# Leave empty and run with ENGINES=fake for the deterministic test engines.
OPENROUTER_API_KEY=
ENGINES=live

# Web session cookie: 32 characters or more (openssl rand -hex 32).
SESSION_SECRET=

# Traces and benches, in the local Langfuse (deploy/langfuse) or any other.
# LANGFUSE_BASE_URL is for processes on this machine (API, benches);
# LANGFUSE_DOCKER_BASE_URL for the API when it runs in Docker (compose.yml).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_DOCKER_BASE_URL=

# The local Langfuse itself (deploy/langfuse): generated by task langfuse:secrets.
LF_USER_EMAIL=admin@delorean.local
LF_USER_PASSWORD=
LF_DB_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_AUTH=
LF_MINIO_PASSWORD=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_NEXTAUTH_SECRET=
