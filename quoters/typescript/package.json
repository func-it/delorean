{
  "name": "@delorean/quoter-typescript",
  "private": true,
  "description": "The TypeScript implementation of the delorean API (api/openapi.yaml), on Node.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/generated/openapi.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@langfuse/core": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "ajv": "^8.20.0",
    "hono": "^4.13.12",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.27.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
