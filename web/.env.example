# Copy to .env.local for `npm run dev`; in production, set these in the environment.

# Seals the session cookie: at least 32 characters, required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# A single quoter. Default: http://localhost:24791
QUOTER_URL=http://localhost:24791

# Or several, as a JSON map of name → URL (takes precedence over QUOTER_URL);
# the first is the default, and the header shows a selector.
# QUOTERS={"go":"http://localhost:24791","python":"http://localhost:24792","typescript":"http://localhost:24793"}

# How long the BFF waits for a quoter, in milliseconds. Default: 35000,
# a little above the quoter's own 30 s budget.
# QUOTER_TIMEOUT_MS=35000

# The strike rule: STRIKE_LIMIT injection refusals within STRIKE_WINDOW_S
# seconds, on one session or username, block it for STRIKE_BLOCK_S seconds
# (429 too_many_refusals); a client address, which a carrier's NAT may share
# between many customers, takes IP_STRIKE_LIMIT, and holds IP_MAX_IN_FLIGHT
# quotes at once (a session or a username, one). A refused text is answered
# from memory for REFUSAL_MEMORY_S seconds. Defaults below.
# STRIKE_LIMIT=3
# IP_STRIKE_LIMIT=10
# IP_MAX_IN_FLIGHT=4
# STRIKE_WINDOW_S=900
# STRIKE_BLOCK_S=900
# REFUSAL_MEMORY_S=21600

# How many proxies of ours sit in front of the app, each appending to
# X-Forwarded-For: the client address is that many entries from the right.
# 0 (default): no proxy, the connection's address. See README.md.
# TRUST_PROXY_HOPS=0
