# Copy to .env.local for `npm run dev`; in production, set these in the environment.

# Seals the session cookie: at least 32 characters, required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# A single backend. Default: http://localhost:24791
BACKEND_URL=http://localhost:24791

# Or several, as a JSON map of name → URL (takes precedence over BACKEND_URL);
# the first is the default, and the header shows a selector.
# BACKENDS={"go":"http://localhost:24791","python":"http://localhost:24792","typescript":"http://localhost:24793"}

# How long the BFF waits for a backend, in milliseconds. Default: 35000,
# a little above the backend's own 30 s budget.
# BACKEND_TIMEOUT_MS=35000
